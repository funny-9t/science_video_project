from training.utils_train import get_device


app = Flask(__name__, 
            template_folder='frontend',
            static_folder='frontend/static')
CORS(app)

# 全局变量 - 缓存加载的模型和编码器
_model = None
_device = None
_text_encoder = None
_audio_encoder = None
_video_encoder = None
_meta_builder = None


def init_models():
    """初始化所有模型和编码器"""
    global _model, _device, _text_encoder, _audio_encoder, _video_encoder, _meta_builder
    
    try:
        # 获取设备
        _device = get_device(CFG.device)
        print(f"Using device: {_device}")
        
        # 加载多模态模型
        _model = MultiModalQualityModel(
            text_dim=CFG.text_dim,
            video_dim=CFG.video_dim,
            audio_dim=CFG.audio_dim,
            meta_dim=CFG.meta_dim,
            hidden_dim=CFG.hidden_dim,
        ).to(_device)
        
        # 兼容加载 - 处理架构变化
        _load_state_dict_compatible(_model, state_dict)
        print(f"✓ Loaded checkpoint from {checkpoint_path}")
    else:
        print(f"⚠ Checkpoint not found at {checkpoint_path}")
        
        _model.eval()
        
        # 初始化编码器
        asr_path = Path(CFG.asr_model_path).resolve()
        audio_path = Path(CFG.audio_model_path).resolve()
        
        _text_encoder = TextEncoder(CFG.text_model_name, str(asr_path), _device, CFG.local_files_only)
        _audio_encoder = AudioEncoder(str(audio_path), _device, out_dim=CFG.audio_dim, shared_model=_text_encoder.asr)
        _video_encoder = VideoEncoder(CFG.clip_model_name, _device)
        
        # 初始化元数据构建器（使用默认类别）
        _meta_builder = MetaFeatureBuilder(
            categories=["科技", "教育", "科普", "演讲", "实验", "评论", "其他"], 
            out_dim=CFG.meta_dim
        )
        
        print("✓ All models initialized successfully")
        return True
        
    except Exception as e:
        print(f"✗ Error initializing models: {e}")
        import traceback
        traceback.print_exc()
        return False


@app.route('/')
def index():
    """主页面"""
    return render_template('index.html')


@app.route('/api/infer', methods=['POST'])
def api_infer():
    """
    推理API端点
    
    支持两种数据格式：
    1. Web表单格式 (前端表单提交)
    2. CSV数据格式 (来自真实数据集)
    
    请求参数:
    {
        "video_id": "str",
        "title": "str",
        "tags": "str (用|分隔)",
        "category": "str",
        "duration": float,
        "publish_time": "datetime string",
        "author_fans": int (optional, 作者粉丝数),
        "like_count": int (optional, 点赞数),
        "share_count": int (optional, 分享数),
        "collect_count": int (optional, 收藏数),
        "comment_count": int (optional, 评论数),
        "recommend_count": int (optional, 推荐数)
    }
    """
    try:
        if _model is None:
            return jsonify({
                "success": False,
                "error": "模型未初始化"
            }), 503
        
        data = request.get_json()
        
        # 验证必需的字段
        required_fields = ['video_id', 'title', 'tags', 'category']
        for field in required_fields:
            if field not in data:
                return jsonify({
                    "success": False,
                    "error": f"缺少必需字段: {field}"
                }), 400
        
        # 构建行数据 - 支持抖音数据格式
        row = {
            "video_id": str(data['video_id']),
            "title": str(data.get('title', '')),
            "tags": str(data.get('tags', '')),
            "category": str(data.get('category', 'unknown')),
            "duration": float(data.get('duration', 0.0)),
            "verified": 1 if data.get('author_fans', 0) > 100000 else 0,  # 粉丝超100万视为认证
            "publish_time": str(data.get('publish_time', '')),
            "label": 0,  # 推理时不使用
        }
        
        # 构建元特征
        meta_feat = _meta_builder.build(row)
        
        # 创建虚拟特征（当没有实际视频文件时）
        # 实际应用中，这些应该从真实视频提取
        text_feat = np.random.randn(CFG.text_dim).astype(np.float32)
        video_feat = np.random.randn(CFG.video_dim).astype(np.float32)
        audio_feat = np.random.randn(CFG.audio_dim).astype(np.float32)
        
        # 转换为张量并添加批处理维度
        text_feat_tensor = torch.tensor(text_feat, dtype=torch.float32).unsqueeze(0).to(_device)
        video_feat_tensor = torch.tensor(video_feat, dtype=torch.float32).unsqueeze(0).to(_device)
        audio_feat_tensor = torch.tensor(audio_feat, dtype=torch.float32).unsqueeze(0).to(_device)
        meta_feat_tensor = torch.tensor(meta_feat, dtype=torch.float32).unsqueeze(0).to(_device)
        
        # 推理
        with torch.no_grad():
            outputs = _model(
                text_feat=text_feat_tensor,
                video_feat=video_feat_tensor,
                audio_feat=audio_feat_tensor,
                meta_feat=meta_feat_tensor
            )
        
        # 提取结果
        result = {
            "success": True,
            "video_id": str(data['video_id']),
            "title": str(data.get('title', '')),
            "category": str(data.get('category', '')),
            "scientific_score": float(outputs["scientific_score"].item()),
            "technical_score": float(outputs["technical_score"].item()),
            "aesthetic_score": float(outputs["aesthetic_score"].item()),
            "overall_score": float(outputs["overall_score"].item()),
            "probability": float(outputs["probability"].item()),
            "prediction": "上榜" if outputs["probability"].item() >= CFG.threshold else "未上榜",
            "engagement": {
                "likes": int(data.get('like_count', 0)),
                "shares": int(data.get('share_count', 0)),
                "collects": int(data.get('collect_count', 0)),
                "comments": int(data.get('comment_count', 0)),
                "recommends": int(data.get('recommend_count', 0))
            },
            "timestamp": datetime.now().isoformat()
        }
        
        return jsonify(result), 200
        
    except Exception as e:
        print(f"推理错误: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({
            "success": False,
            "error": str(e)
        }), 500


@app.route('/api/health', methods=['GET'])
def health_check():
    """健康检查"""
    status = "ready" if _model is not None else "initializing"
    return jsonify({
        "status": status,
        "timestamp": datetime.now().isoformat()
    }), 200


@app.errorhandler(404)
def not_found(e):
    return jsonify({"error": "Not found"}), 404


@app.errorhandler(500)
def internal_error(e):
    return jsonify({"error": "Internal server error"}), 500


if __name__ == '__main__':
    print("初始化模型和编码器...")
    if init_models():
        print("✓ 服务已启动")
        app.run(debug=False, host='0.0.0.0', port=5000)
    else:
        print("✗ 无法启动服务 - 模型初始化失败")
        sys.exit(1)
